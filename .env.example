PORT=5000
NODE_ENV=development
# Local:
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:5000
# Production (Render + Vercel):
FRONTEND_URL=https://kincore-tree.vercel.app
# Mobile native app OAuth return (Flutter APK) — deep link, not a web URL
# APP_OAUTH_REDIRECT=kincore://auth/callback
# Optional web fallback for Flutter web (Netlify) — NOT used for native APK redirect
APP_URL=https://kincore-tree.netlify.app
# Optional comma-separated extra allowed OAuth redirect origins
# OAUTH_REDIRECT_ORIGINS=https://uat-admin.kincore.com,https://uat.kincore.com
BACKEND_URL=https://kincore-tree-backend.onrender.com

# --- UAT (VPS) — admin + mobile Google OAuth ---
# FRONTEND_URL=https://uat-admin.kincore.com
# BACKEND_URL=https://uat-api.kincore.com
# APP_OAUTH_REDIRECT=kincore://auth/callback
# Do NOT set APP_URL=https://uat.app.kincore.com for native APK — that causes browser redirect instead of kincore://
SUPABASE_URL=https://fpzuqnpoksaeacedirns.supabase.co
SUPABASE_ANON_KEY=sb_publishable_kPpwNv366jML2cE1HNtMaA_3ia5XAmF
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_OR_SB_SECRET_KEY

# Google SSO — Authorized redirect URI must match EXACTLY (no trailing slash / newline)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:  http://localhost:5000/api/auth/google/callback
# Live:   https://kincore-tree-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://kincore-tree-backend.onrender.com/api/auth/google/callback

# Facebook / Meta SSO — Valid OAuth Redirect URI in Meta Developer Console
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Local:  http://localhost:5000/api/auth/facebook/callback
# Live:   https://kincore-tree-backend.onrender.com/api/auth/facebook/callback
FACEBOOK_REDIRECT_URI=https://kincore-tree-backend.onrender.com/api/auth/facebook/callback

# Optional SMTP for real email delivery (Family Admin Notification Policies)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kincore <notifications@kccdigital.com>

# Optional Stripe for live provider refunds (Business Billing)
STRIPE_SECRET_KEY=

# App environment for Deploy Status mapping (production | staging | testing)
# development / local map to "testing"
APP_ENV=testing
# Optional per-env URL labels shown in DevOps Environments panel
# APP_URL_PRODUCTION=
# APP_URL_STAGING=
# APP_URL_TESTING=
# FRONTEND_URL_PRODUCTION=
# FRONTEND_URL_STAGING=
# FRONTEND_URL_TESTING=

# Optional PlenorHub / BigK for live Mall + KCC ledger (Business Ops)
# Auth is KCC ID user login (super_admin / plenorhub_admin) — not client_credentials
BIGK_ADMIN_IDENTIFIER=
BIGK_ADMIN_PASSWORD=
BIGK_ADMIN_CLIENT_ID=bigk_admin
# BIGK_AUTH_URL=https://auth.bigkpay.com/kccid/v1/login
# BIGK_ADMIN_API_BASE=https://api.bigkpay.com/api/v1
# PLENORHUB_API_BASE=https://api.plenorhub.com/api/v1

# KCC ID — Continue with KCC (client_id must be registered as "kincore")
KCC_ID_BASE_URL=https://auth.bigkpay.com
KCC_CLIENT_ID=kincore

